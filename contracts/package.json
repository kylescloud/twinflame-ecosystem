{
  "name": "twinflame-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "TwinFlame Protocol smart contracts (BLAZE, EMBER, EQT, Swap, Lending, Governance, Dividends)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
